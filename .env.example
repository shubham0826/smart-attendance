# Copy this file to .env and set the local MySQL account password.
# CSV remains the default until ATTENDANCE_STORAGE is changed to mysql.
ATTENDANCE_STORAGE=csv
ATTENDANCE_DB_HOST=127.0.0.1
ATTENDANCE_DB_PORT=3306
ATTENDANCE_DB_NAME=smart_attendance
ATTENDANCE_DB_USER=smart_attendance_app
ATTENDANCE_DB_PASSWORD=replace_with_your_local_password
